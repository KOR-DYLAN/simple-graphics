PROJECT_NAME           = "Simple Graphics Library"
PROJECT_NUMBER         = "@SGL_FULL_VERSION@"
PROJECT_BRIEF          = "Runtime-independent image processing primitives"

OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
HIDE_IN_BODY_DOCS      = YES

INPUT                  = "@CMAKE_SOURCE_DIR@/include/sgl-compiler.h" \
                         "@CMAKE_SOURCE_DIR@/include/sgl-core.h" \
                         "@CMAKE_SOURCE_DIR@/include/sgl-fixed_point.h" \
                         "@CMAKE_SOURCE_DIR@/include/sgl-fourcc.h" \
                         "@CMAKE_SOURCE_DIR@/include/sgl-type.h" \
                         "@CMAKE_SOURCE_DIR@/include/fixed_point/generic.h" \
                         "@CMAKE_SOURCE_DIR@/include/fixed_point/neon.h" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/api"
FILE_PATTERNS          = *.h *.dox
RECURSIVE              = YES
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@"

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
WARN_LOGFILE           = "@CMAKE_BINARY_DIR@/docs/doxygen-warnings.log"

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_MENUS     = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
DISABLE_INDEX          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

HAVE_DOT               = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
INCLUDE_PATH           = "@CMAKE_SOURCE_DIR@/include" \
                         "@CMAKE_BINARY_DIR@"
PREDEFINED             = __DOXYGEN__ \
                         SGL_CFG_HAS_SIMD \
                         SGL_CFG_HAS_THREAD \
                         SGL_CFG_HAS_NEON \
                         "SGL_RESTRICT=" \
                         "SGL_ALWAYS_INLINE=inline"
