menu "Tests"

config SGL_TEST_CROP_REPEAT_COUNT
	int "Crop repeats"
	default "10"
	minimum 1
	depends on WITH_TEST_APP
	cmake
	help
	  Measured crop benchmark iterations.

config SGL_TEST_CROP_WARMUP_COUNT
	int "Crop warm-ups"
	default "3"
	minimum 0
	depends on WITH_TEST_APP
	cmake
	help
	  Untimed crop benchmark warm-up iterations.

